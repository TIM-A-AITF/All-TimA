# ===== Path (bawaan Docker sudah benar; isi hanya bila ingin mengganti) =====
# TOR_RAB_WORKSPACE=/data/workspace
# CHECKLIST_RULES_DIR=/app/Checklist-Rule-TOR-RAB/rules
# CHECKLIST_KATALOG_DIR=/data/workspace/cache/katalog_sbm
# CHECKLIST_WILAYAH_CSV=/app/Checklist-Rule-TOR-RAB/wilayah_indonesia.csv
# TESSERACT_CMD=            # kosong = /usr/bin/tesseract dari PATH

# ===== VLM: Qwen3-VL-2B di VPS terpisah (kosong = deskripsi gambar dilewati) =====
VLM_ENDPOINT_URL=
# contoh vLLM:  VLM_ENDPOINT_URL=http://<IP_VPS_VLM>:8000/v1/chat/completions
# openai (vLLM/OpenAI-compatible) | custom
VLM_API_STYLE=openai
VLM_API_KEY=
VLM_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
VLM_TIMEOUT_SEC=180
VLM_MIN_AREA=2500

# ===== SFT: Qwen3-4B-Instruct-2507 + LoRA di VPS terpisah (kosong = I.M-I.R berstatus MANUAL) =====
SFT_ENDPOINT_URL=
# contoh: SFT_ENDPOINT_URL=http://<IP_VPS_SFT>:8000/evaluate
SFT_API_KEY=
SFT_BASE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
SFT_MODEL_VERSION=qwen3-4b-instruct-2507-lora
SFT_TIMEOUT_SEC=120

# ===== Lain-lain =====
PAIR_MIN_SCORE=0.35
MAX_UPLOAD_MB=50
PIPELINE_WORKERS=1
KEEP_WORK_DIR=false
